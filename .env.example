# ============================================================
# Polymarket Trader - Konfiguration
# ============================================================
# Kopiere diese Datei nach .env und trage deine Werte ein

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Polymarket Wallet (Polygon-Wallet) ---
# Dein privater Schlüssel (NIEMALS teilen!)
POLYGON_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Polymarket API Schlüssel (aus deinem Polymarket-Account)
CLOB_API_KEY=your_clob_api_key
CLOB_SECRET=your_clob_secret
CLOB_PASS_PHRASE=your_clob_passphrase

# --- Trading-Konfiguration ---
# Maximale Position pro Trade in USD
MAX_POSITION_SIZE=10.0

# Maximales Gesamtportfolio-Risiko in USD
MAX_PORTFOLIO_RISK=100.0

# Minimale Konfidenz für Trades (0.0 - 1.0)
MIN_CONFIDENCE_THRESHOLD=0.7

# Maximale Anzahl offener Positionen
MAX_OPEN_POSITIONS=5

# Handelsintervall in Minuten
TRADING_INTERVAL_MINUTES=15

# --- Polymarket API ---
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com

# --- Modus ---
# DRY_RUN=true führt KEINE echten Trades aus (zum Testen)
DRY_RUN=true

# Logging-Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
