# ============================================================
# Polymarket Trader - Konfiguration
# ============================================================
# Kopiere diese Datei nach .env und trage deine Werte ein

# --- LLM Provider ---
# "anthropic"  → Claude API (Standard)
# "ollama"     → lokales Ollama (kein API-Key nötig)
LLM_PROVIDER=anthropic

# --- Anthropic / Claude (nur wenn LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Ollama (nur wenn LLM_PROVIDER=ollama) ---
# URL zum Ollama-Server (Standard: localhost:11434)
# Im Docker-Compose-Setup: http://ollama:11434
OLLAMA_URL=http://localhost:11434
# Modell mit Tool-Use-Unterstützung: llama3.1:8b, qwen2.5:7b, mistral-nemo
OLLAMA_MODEL=llama3.1:8b

# --- Polymarket Wallet (Polygon-Wallet) ---
# Dein privater Schlüssel (NIEMALS teilen!)
POLYGON_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deine Polymarket Proxy-Wallet-Adresse (sichtbar unter polymarket.com/settings → Profil)
# Bei Privy-Embedded-Wallets (Email/Google-Login): FUNDER_ADDRESS = deine Polymarket-Konto-Adresse
# Beispiel: 0x4D5767B6Bd618689F6b4C187374FA0a3948CFDcc
FUNDER_ADDRESS=0xYOUR_POLYMARKET_ACCOUNT_ADDRESS_HERE

# Polymarket API Schlüssel (aus deinem Polymarket-Account)
CLOB_API_KEY=your_clob_api_key
CLOB_SECRET=your_clob_secret
CLOB_PASS_PHRASE=your_clob_passphrase

# --- News (Google News RSS — kostenlos, kein API-Key nötig) ---
# Anzahl Keywords die aus der Marktfrage extrahiert werden
NEWS_MAX_KEYWORDS=5
# Maximale Artikel pro Marktabfrage
NEWS_MAX_ARTICLES=5

# --- News-Watcher (push-ähnlicher Modus: python main.py watch) ---
# Statische Keywords die immer überwacht werden (komma-getrennt)
# Zusätzlich werden automatisch Keywords aus aktiven Märkten extrahiert
NEWS_WATCH_KEYWORDS=Trump,Bitcoin,Fed,election,war,ceasefire
# Poll-Intervall in Sekunden (wie oft RSS abgefragt wird)
NEWS_WATCH_INTERVAL=90
# Mindest-Pause in Sekunden zwischen zwei KI-Aktivierungen (verhindert Spam)
NEWS_COOLDOWN=300

# --- Trading-Konfiguration ---
# Maximale Position pro Trade in USD
MAX_POSITION_SIZE=10.0

# Maximales Gesamtportfolio-Risiko in USD
MAX_PORTFOLIO_RISK=100.0

# Minimale Konfidenz für Trades (0.0 - 1.0)
MIN_CONFIDENCE_THRESHOLD=0.7

# Maximale Anzahl offener Positionen
MAX_OPEN_POSITIONS=5

# Handelsintervall in Minuten
TRADING_INTERVAL_MINUTES=15

# --- Polymarket API ---
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com

# --- Modus ---
# DRY_RUN=true führt KEINE echten Trades aus (zum Testen)
DRY_RUN=true

# Logging-Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
